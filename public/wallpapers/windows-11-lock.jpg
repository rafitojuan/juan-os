<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 1080" width="1920" height="1080">
  <defs>
    <radialGradient id="lock-bg" cx="50%" cy="40%" r="80%">
      <stop offset="0%" stop-color="#0e172a"/>
      <stop offset="50%" stop-color="#070d18"/>
      <stop offset="100%" stop-color="#020408"/>
    </radialGradient>
    <radialGradient id="glow" cx="50%" cy="45%" r="50%">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.6"/>
      <stop offset="35%" stop-color="#2563eb" stop-opacity="0.4"/>
      <stop offset="70%" stop-color="#6366f1" stop-opacity="0.15"/>
      <stop offset="100%" stop-color="#000000" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="horizon" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0284c7" stop-opacity="0.3"/>
      <stop offset="100%" stop-color="#7c3aed" stop-opacity="0.2"/>
    </linearGradient>
  </defs>
  <rect width="1920" height="1080" fill="url(#lock-bg)"/>
  <rect width="1920" height="1080" fill="url(#horizon)"/>
  <circle cx="960" cy="500" r="550" fill="url(#glow)"/>
  <circle cx="960" cy="500" r="320" fill="#38bdf8" opacity="0.05"/>
</svg>